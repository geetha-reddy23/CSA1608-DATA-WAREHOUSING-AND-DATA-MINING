# Diabetes Dataset Analysis

# Read the CSV file
diabetes <- read.csv("diabetes.csv")

# Display dataset information
head(diabetes)
str(diabetes)

# Remove missing values in required columns
diabetes <- diabetes[
  complete.cases(diabetes[, c("Age", "BloodPressure")]),
]

# Scatterplot: Blood Pressure vs Age
plot(diabetes$Age, diabetes$BloodPressure,
     main = "Blood Pressure vs Age",
     xlab = "Age",
     ylab = "Blood Pressure",
     pch = 19,
     col = "blue")

# Add trend line
abline(lm(BloodPressure ~ Age, data = diabetes),
       col = "red",
       lwd = 2)

# Calculate average blood pressure for each age
avg_bp <- aggregate(
  BloodPressure ~ Age,
  data = diabetes,
  FUN = mean
)

# Bar chart of average blood pressure by age
barplot(avg_bp$BloodPressure,
        names.arg = avg_bp$Age,
        main = "Average Blood Pressure by Age",
        xlab = "Age",
        ylab = "Average Blood Pressure",
        col = "lightblue",
        las = 2,
        cex.names = 0.7)
